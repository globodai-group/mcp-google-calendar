  },
  "homepage": "https://github.com/artik0din/mcp-google-calendar#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "googleapis": "^144.0.0",
    "google-auth-library": "^9.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
