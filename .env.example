# Google OAuth2 Configuration (Required)
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# OAuth2 Redirect URI (Optional)
# For desktop apps, use the default oob (out of band) flow
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Encryption Master Key (Optional)
# If not provided, will be auto-generated and stored locally
MCP_MASTER_KEY=your_random_master_key_for_token_encryption